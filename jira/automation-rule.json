{
  "rule": {
    "name": "Dispatch Database Deployment on CAB Approval",
    "description": "Triggers GitHub Actions repository_dispatch upon transition to CAB Approved",
    "trigger": {
      "type": "issue_transitioned",
      "to_status": "CAB Approved"
    },
    "conditions": [
      {
        "type": "issue_property",
        "field": "issuetype",
        "operator": "equals",
        "value": "Change"
      }
    ],
    "action": {
      "type": "send_web_request",
      "url": "https://api.github.com/repos/YOUR_ORG/YOUR_REPO/dispatches",
      "method": "POST",
      "headers": {
        "Accept": "application/vnd.github+json",
        "Authorization": "Bearer YOUR_GITHUB_PAT",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "body": "{\n  \"event_type\": \"jira-cab-approved\",\n  \"client_payload\": {\n    \"issue_key\": \"{{issue.key}}\",\n    \"summary\": \"{{issue.summary.asJsonString}}\",\n    \"approver\": \"{{initiator.displayName}}\"\n  }\n}"
    }
  }
}
